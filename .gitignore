*~
.DS_Store

# ignore development environment files
.asciidoctor/
vendor/
.mise
bin/

# ignore unwanted project folders
build/
src/images/diagrams/

# ignore extra files, but keep folder 'files'
src/files/*
!src/files/.keep

# ignore video files, but keep folder 'videos'
src/images/videos/*
!src/images/videos/.keep

# ignore generated html/pdf files only
src/*.pdf
src/**/*.html
!src/**/*docinfo*.html
